import pandas as pd

# -----------------------------------------
# DATA HANDLING FUNCTIONS USING PANDAS
# -----------------------------------------

# Reading employees.csv
data = pd.read_csv("employees.csv")

print("ORIGINAL DATA")
print(data)

# -----------------------------------------
# 1. Handling Missing Data - isnull()
# -----------------------------------------
print("\nNULL VALUES IN TEAM COLUMN")
bool_series = pd.isnull(data["Team"])
print(data[bool_series])

# -----------------------------------------
# 2. Handling Missing Data - notnull()
# -----------------------------------------
print("\nNON-NULL VALUES IN GENDER COLUMN")
bool_series = pd.notnull(data["Gender"])
print(data[bool_series])

# -----------------------------------------
# 3. Dropping Missing Values - dropna()
# -----------------------------------------
print("\nDATA AFTER DROPPING NULL VALUES")
new_data = data.dropna(axis=0, how='any')
print(new_data)

# -----------------------------------------
# 4. Filling Missing Values - fillna()
# -----------------------------------------
print("\nDATA AFTER FILLING MISSING TEAM VALUES")

data["Team"] = data["Team"].fillna("No Team")
print(data)

# -----------------------------------------
# 5. Transform Data using apply()
# -----------------------------------------
print("\nAPPLY() OPERATION")

def check_salary(num):
    if num < 50000:
        return "Low"
    elif num >= 50000 and num < 100000:
        return "Normal"
    else:
        return "High"

new = data["Salary"].apply(check_salary)
print(new)

# -----------------------------------------
# 6. Transform Data using map()
# -----------------------------------------
print("\nMAP() OPERATION")

gender_map = {
    "Male": "M",
    "Female": "F"
}

mapped_gender = data["Gender"].map(gender_map)
print(mapped_gender)

# -----------------------------------------
# 7. Detect and Filter Outliers
# -----------------------------------------
print("\nDATA DESCRIPTION")

df = data.drop(columns=["First Name", "Gender"])
print(df.describe())

# -----------------------------------------
# 8. Vectorized String Operation - upper()
# -----------------------------------------
print("\nTEAM COLUMN IN UPPERCASE")

data["Team"] = data["Team"].str.upper()
print(data["Team"])

# -----------------------------------------
# 9. Vectorized String Operation - lower()
# -----------------------------------------
print("\nFIRST NAME IN LOWERCASE")

data["First Name"] = data["First Name"].str.lower()
print(data["First Name"])

